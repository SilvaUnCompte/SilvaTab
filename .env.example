# Password asked by the web UI
SILVA_PASSWORD=change-me

# Token used by MCP clients (generate one with: openssl rand -hex 32)
MCP_TOKEN=change-me-too

# Host port of the app
PORT=3000

# Host interface the port is published on. Keep 127.0.0.1 behind a reverse proxy,
# use 0.0.0.0 to reach the app directly from the LAN.
BIND_ADDRESS=127.0.0.1

# Only for local dev without compose (npm run dev)
MONGO_URL=mongodb://localhost:27017
